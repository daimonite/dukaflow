# ==============================================================================
# Supabase Configuration (Required for cloud sync & remote database)
# Get these from: Supabase Dashboard -> Project Settings -> API / Data API
# ==============================================================================
VITE_SUPABASE_URL="https://your-project-id.supabase.co"
VITE_SUPABASE_ANON_KEY="your-supabase-anon-key"

# Optional. URL the confirmation email returns to. Must be allow-listed in
# Supabase -> Authentication -> URL Configuration -> Redirect URLs.
# Defaults to the current site origin; set it for the Android build.
# VITE_AUTH_REDIRECT_URL="https://your-app.example.com/"
